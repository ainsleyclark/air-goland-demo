### Valid event
< {%
    const timestamp = Math.floor(Date.now() / 1000);
    const signature = crypto.hmac.sha256()
        .withTextSecret(request.environment.get("secret"))
        .updateWithText(`${timestamp}.${request.body.tryGetSubstituted()}`)
        .digest().toHex();
    request.variables.set("signature", `t=${timestamp},v1=${signature}`);
%}
POST {{host}}/webhooks/stripe
Content-Type: application/json
Webhook-Signature: {{signature}}

{"id": "evt_1A2b3C4d5E6f7G8h9I0jK1lM", "type": "payment.succeeded", "data": {"amount": 2500, "currency": "gbp"}}

